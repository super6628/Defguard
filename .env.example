### DB configuration ###
DEFGUARD_DB_HOST="localhost"
DEFGUARD_DB_PORT=5432
DEFGUARD_DB_NAME="defguard"
DEFGUARD_DB_USER="defguard"
DEFGUARD_DB_PASSWORD="defguard"
# for SQLX CLI
DATABASE_URL="postgresql://defguard:defguard@localhost/defguard"

### For localhost only ###
# DEFGUARD_COOKIE_INSECURE=true

### Logging ###
DEFGUARD_LOG_LEVEL=info

### HTTP Port ###
DEFGUARD_HTTP_PORT=8000

### GRPC Port ###
DEFGUARD_GRPC_PORT=50055
# DEFGUARD_GRPC_BIND_ADDRESS=
# DEFGUARD_HTTP_BIND_ADDRESS=

### OpenID Connect ###
# DEFGUARD_OPENID_KEY=

### White-label / support ###
# Backend-generated emails and support operations cannot read VITE_* browser variables.
# Configure server-side customer-facing destinations here when those surfaces are enabled.
# Required for the "send support data" action. No upstream recipient is used by default.
# DEFGUARD_SUPPORT_EMAIL="support@example.com"
# Optional branded destinations for backend-generated content.
# DEFGUARD_BRAND_DOWNLOAD_URL="https://secure.example.com/download"
# DEFGUARD_BRAND_HELP_URL="https://secure.example.com/help"

### Docker-compose images ###
IMAGE_TAG=dev
