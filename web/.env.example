# Customer-facing branding overrides
# All values are optional. S-Metric Secure / S-Metric are used by default.
VITE_BRAND_PRODUCT_NAME="S-Metric Secure"
VITE_BRAND_COMPANY_NAME="S-Metric"

# Visual identity
# VITE_BRAND_LOGO_URL="https://example.com/logo.svg"
# VITE_BRAND_COMPACT_LOGO_URL="https://example.com/logo-compact.svg"
# VITE_BRAND_FAVICON_URL="https://example.com/favicon.ico"

# Contact and website
# VITE_BRAND_SUPPORT_EMAIL="support@example.com"
# VITE_BRAND_WEBSITE_URL="https://example.com"

# Customer-facing links. When omitted, compatibility fallbacks may point to
# the upstream Defguard documentation, distribution, or support services.
# VITE_BRAND_DOCUMENTATION_URL="https://docs.example.com"
# VITE_BRAND_PRICING_URL="https://example.com/pricing"
# VITE_BRAND_DOWNLOAD_URL="https://example.com/download"
# VITE_BRAND_SALES_URL="https://example.com/contact"
# VITE_BRAND_BUG_REPORT_URL="https://example.com/bugs"
# VITE_BRAND_FEATURE_REQUEST_URL="https://example.com/features"
# VITE_BRAND_SUPPORT_TICKET_URL="https://support.example.com"
# VITE_BRAND_SCHEDULE_CALL_URL="https://example.com/schedule"
